<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/controller_outline"
        android:alpha="0.6"
        android:id="@+id/bg_controller"/>

    <!-- Tombol Setting di Pojok Kanan Atas -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Ikon Indikator Koneksi -->
        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_wifi_off" />

        <!-- Ikon Gear untuk Buka Settings -->
        <ImageView
            android:id="@+id/btnOpenSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- AREA GAMEPAD -->
    <FrameLayout
        android:id="@+id/gamepadArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Container L2 & R2 -->
        <FrameLayout android:id="@+id/containerL2" android:layout_width="80dp" android:layout_height="220dp" android:layout_gravity="left|center_vertical" android:layout_marginLeft="20dp">
            <View android:layout_width="4dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:background="#333333" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L2" android:textColor="#C5C8CC" android:layout_gravity="top|center_horizontal" android:textStyle="bold" />
            <SeekBar android:id="@+id/btnL2" android:layout_width="180dp" android:layout_height="80dp" android:layout_gravity="center" android:rotation="-90" android:max="100" android:progress="0" android:progressTint="#4CAF50" android:thumbTint="#4CAF50" />
        </FrameLayout>

        <FrameLayout android:id="@+id/containerR2" android:layout_width="80dp" android:layout_height="220dp" android:layout_gravity="right|center_vertical" android:layout_marginRight="20dp">
            <View android:layout_width="4dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:background="#333333" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R2" android:textColor="#C5C8CC" android:layout_gravity="top|center_horizontal" android:textStyle="bold" />
            <SeekBar android:id="@+id/btnR2" android:layout_width="180dp" android:layout_height="80dp" android:layout_gravity="center" android:rotation="-90" android:max="100" android:progress="0" android:progressTint="#F44336" android:thumbTint="#F44336" />
        </FrameLayout>

        <!-- D-PAD -->
        <Button android:id="@+id/dpadUp" android:text="▲" android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="18sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/dpadDown" android:text="▼" android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="18sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/dpadLeft" android:text="◀" android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="18sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/dpadRight" android:text="▶" android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="18sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />

        <!-- FACE BUTTONS -->
        <Button android:id="@+id/btnY" android:text="△" android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="22sp" android:background="@android:color/transparent" android:textColor="#4CAF50" />
        <Button android:id="@+id/btnA" android:text="✕" android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="22sp" android:background="@android:color/transparent" android:textColor="#F44336" />
        <Button android:id="@+id/btnX" android:text="□" android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="22sp" android:background="@android:color/transparent" android:textColor="#2196F3" />
        <Button android:id="@+id/btnB" android:text="○" android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="22sp" android:background="@android:color/transparent" android:textColor="#F44336" />

        <!-- SHOULDER & CENTER BUTTONS -->
        <Button android:id="@+id/btnL1" android:text="L1" android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp" android:textSize="14sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnR1" android:text="R1" android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp" android:textSize="14sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnShare" android:text="SHARE" android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnPS" android:text="PS" android:layout_width="50dp" android:layout_height="40dp" android:padding="0dp" android:textSize="12sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnOptions" android:text="OPTIONS" android:layout_width="70dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />

        <!-- ANALOG STICKS -->
        <com.example.ds4remote.JoystickView android:id="@+id/leftStick" android:layout_width="160dp" android:layout_height="160dp" />
        <com.example.ds4remote.JoystickView android:id="@+id/rightStick" android:layout_width="160dp" android:layout_height="160dp" />

        <!-- L3 / R3 / TOUCHPAD -->
        <Button android:id="@+id/btnL3" android:text="L3" android:layout_width="55dp" android:layout_height="40dp" android:padding="0dp" android:textSize="12sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnTouchpad" android:text="TOUCHPAD" android:layout_width="100dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
        <Button android:id="@+id/btnR3" android:text="R3" android:layout_width="55dp" android:layout_height="40dp" android:padding="0dp" android:textSize="12sp" android:background="@android:color/transparent" android:textColor="#C5C8CC" />
    </FrameLayout>
</RelativeLayout>